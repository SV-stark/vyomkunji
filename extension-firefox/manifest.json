{
  "manifest_version": 2,
  "name": "VyomKunji — India G2C Digital Signing",
  "version": "0.2.1",
  "description": "Unified digital signing on Indian government portals using your DSC token.",
  "permissions": [
    "nativeMessaging",
    "storage",
    "activeTab",
    "https://*.incometax.gov.in/*",
    "https://incometax.gov.in/*",
    "https://*.gst.gov.in/*",
    "https://gst.gov.in/*",
    "https://*.mca.gov.in/*",
    "https://mca.gov.in/*",
    "https://*.epfindia.gov.in/*",
    "https://epfindia.gov.in/*",
    "https://*.tdscpc.gov.in/*",
    "https://tdscpc.gov.in/*",
    "https://*.traces.gov.in/*",
    "https://traces.gov.in/*"
  ],
  "background": {
    "scripts": ["src/background.js"]
  },
  "content_scripts": [
    {
      "matches": ["https://*.incometax.gov.in/*", "https://incometax.gov.in/*"],
      "js": ["src/content/incometax.js"],
      "run_at": "document_idle"
    },
    {
      "matches": [
        "https://*.gst.gov.in/*", "https://gst.gov.in/*",
        "https://*.mca.gov.in/*", "https://mca.gov.in/*",
        "https://*.epfindia.gov.in/*", "https://epfindia.gov.in/*",
        "https://*.tdscpc.gov.in/*", "https://tdscpc.gov.in/*",
        "https://*.traces.gov.in/*", "https://traces.gov.in/*"
      ],
      "js": ["src/content/generic.js"],
      "run_at": "document_idle"
    }
  ],
  "browser_action": {
    "default_popup": "src/popup/popup.html",
    "default_title": "VyomKunji"
  },
  "web_accessible_resources": ["src/content/interceptor-main.js"],
  "options_ui": {
    "page": "src/options/options.html",
    "open_in_tab": true
  },
  "browser_specific_settings": {
    "gecko": {
      "id": "vyomkunji-g2c@vyomkunji.local",
      "strict_min_version": "115.0"
    }
  },
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
